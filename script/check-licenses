#!/usr/bin/env bash
# Audits the licenses of the entire dependency graph. Run as part of the
# post-merge verification step in UPSTREAM.md.
# Fails when:
#   1) a local (path) crate is not Apache-2.0, or
#   2) any package's license contains unavoidable copyleft
#      (no permitted license among its OR-alternatives)
set -euo pipefail
cd "$(dirname "$0")/.."

meta="$(mktemp)"
trap 'rm -f "$meta"' EXIT
cargo metadata --format-version 1 > "$meta"

python3 - "$meta" <<'EOF'
import json, re, sys

ALLOWED = re.compile(
    r"^(Apache-2\.0( WITH LLVM-exception)?|MIT|MIT-0|BSD-[0-3]-Clause|ISC|Zlib|0BSD"
    r"|Unlicense|CC0-1\.0|BSL-1\.0|Unicode-3\.0|Unicode-DFS-2016|NCSA|OpenSSL"
    r"|MPL-2\.0|bzip2-1\.0\.6)$"
)

def part_ok(part):
    return bool(ALLOWED.match(part.strip()))

def license_ok(expr):
    expr = expr.replace("/", " OR ")
    for and_part in re.split(r"\bAND\b", expr):
        if not any(part_ok(p.strip("() ")) for p in re.split(r"\bOR\b", and_part)):
            return False
    return True

meta = json.load(open(sys.argv[1]))
failures = []
for p in meta["packages"]:
    lic = p.get("license")
    local = p["source"] is None
    if local:
        if lic != "Apache-2.0":
            failures.append(f"local crate {p['name']}: license = {lic!r} (must be Apache-2.0)")
    elif not lic:
        failures.append(f"{p['name']}: missing license field (license-file: {p.get('license_file')})")
    elif not license_ok(lic):
        failures.append(f"{p['name']}: {lic}")

if failures:
    print("License audit failed:")
    for f in failures:
        print(f"  - {f}")
    sys.exit(1)
print(f"OK: {len(meta['packages'])} packages passed")
EOF
